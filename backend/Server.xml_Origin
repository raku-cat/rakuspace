<?xml version="1.0" encoding="UTF-8" ?>

<Server version="8">
	<Name>rakuspace-origin</Name>
	<Type>origin</Type>
	<IP>0.0.0.0</IP>
	<PrivacyProtection>false</PrivacyProtection>

	<Modules>
        <HTTP2>
			<Enable>false</Enable>
		</HTTP2>
		<LLHLS>
			<Enable>false</Enable>
		</LLHLS>
	</Modules>

	<!-- OME >= 0.19.1: global CORS default, required for CORS headers to be
	     set on responses the deprecated per-VirtualHost CrossDomains block
	     below no longer covers, notably WHIP's own 201 Created response.
	     See https://github.com/AirenSoft/OvenMediaEngine/issues/1593. On
	     older OME this block is simply unused; keep the VirtualHost one
	     too for that case. -->
	<Defaults>
		<CrossDomains>
			<Url>*</Url>
		</CrossDomains>
	</Defaults>


	<Bind>
		<Providers>
			<RTMP>
				<Port>${env:OME_RTMP_PROV_PORT:1935}</Port>
				<WorkerCount>1</WorkerCount>
			</RTMP>
			<!-- WHIP (WebRTC-HTTP Ingestion Protocol) ingest, used by RakuSpace's
			     in-browser "Go Live!" screenshare page. In a split origin/edge
			     setup this belongs on the origin, alongside the RTMP provider,
			     not on the edge (Server.xml_Edge is playback-only). -->
			<WebRTC>
				<Signalling>
					<TLSPort>${env:OME_WEBRTC_SIGNALLING_TLS_PORT:3334}</TLSPort>
					<WorkerCount>1</WorkerCount>
				</Signalling>
				<IceCandidates>
					<IceCandidate>${env:OME_HOST_IP:*}:${env:OME_WEBRTC_CANDIDATE_PORT:10000-10004/udp}</IceCandidate>
					<TcpRelay>${env:OME_HOST_IP:*}:${env:OME_WEBRTC_TCP_RELAY_PORT:3478}</TcpRelay>
					<TcpForce>false</TcpForce>
					<TcpRelayWorkerCount>1</TcpRelayWorkerCount>
				</IceCandidates>
			</WebRTC>
		</Providers>

		<Publishers>
			<!-- The OVT is protocol for ORIGIN-EDGE -->
			<OVT>
				<Port>${env:OME_ORIGIN_PORT:9000}</Port>
				<WorkerCount>1</WorkerCount>
			</OVT>
		</Publishers>
	</Bind>


	<VirtualHosts>
		<VirtualHost>
			<Name>rakuspace-origin</Name>
			
			<!-- Settings for multi ip/domain and TLS -->
			<Host>
				<Names>
					<Name>*</Name>
				</Names>
			</Host>

			<!-- Default CORS Settings -->
			<CrossDomains>
				<Url>*</Url>
			</CrossDomains>

			<!-- Settings for applications -->
			<AdmissionWebhooks>
				<ControlServerUrl>http://0.0.0.0:6868/auth/ome</ControlServerUrl>
				<Timeout>3000</Timeout>
				<Enables>
					<Providers>rtmp,webrtc</Providers>
				</Enables>
			</AdmissionWebhooks>
			<Applications>
				<Application>
					<Name>rakuspace</Name>
					<!-- Application type (live/vod) -->
					<Type>live</Type>
					<OutputProfiles>

						<OutputProfile>
							<Name>bypass_stream</Name>
							<OutputStreamName>${OriginStreamName}</OutputStreamName>
							<Encodes>
								<Video>
									<Name>bypass_video</Name>
									<Bypass>true</Bypass>
								</Video>
								<Audio>
									<Name>aac_audio</Name>
									<Codec>aac</Codec>
									<Bitrate>128000</Bitrate>
									<Samplerate>48000</Samplerate>
									<Channel>2</Channel>
									<BypassIfMatch>
										<Codec>eq</Codec>
									</BypassIfMatch>
								</Audio>								
								<Audio>
									<Name>opus_audio</Name>
									<Codec>opus</Codec>
									<Bitrate>128000</Bitrate>
									<Samplerate>48000</Samplerate>
									<Channel>2</Channel>
									<BypassIfMatch>
										<Codec>eq</Codec>
									</BypassIfMatch>									
								</Audio>
							</Encodes>
						</OutputProfile>
					</OutputProfiles>
					<Providers>
						<RTMP />
						<WebRTC />
					</Providers>
					<Publishers>
						<AppWorkerCount>1</AppWorkerCount>
						<StreamWorkerCount>8</StreamWorkerCount>
						<OVT />
					</Publishers>
				</Application>

			</Applications>
		</VirtualHost>
	</VirtualHosts>


</Server>