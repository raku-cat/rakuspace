FROM python:3.13-slim

WORKDIR /app

ENV VIRTUAL_ENV=/opt/python_modules
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
RUN apt-get update && apt-get install -y gcc

COPY RakuSpace.py /app
COPY setup_db.py /app
COPY requirements.txt /app
COPY templates/ /app/templates
COPY static/ /app/static
COPY rakuspace.cfg.example /app/rakuspace.cfg

RUN pip install --no-cache-dir -r /app/requirements.txt
RUN python setup_db.py 

ENTRYPOINT ["granian"]
# --workers pinned at 1: live-state/notify-state and the SSE Condition are in-process
# memory (see CLAUDE.md), so running more than one worker would desync them.
CMD ["--host", "0.0.0.0", "--port", "6868", "--interface", "wsgi", "--workers", "1", "--access-log", "RakuSpace:app"]
