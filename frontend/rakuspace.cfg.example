# Secret key used to sign session cookies and CSRF tokens. Generate a real
# random value per deployment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY = 'change-me'

# Host of your RTMP provider (where users will be streaming to).
OME_PROVIDER_HOST = 'localhost'
OME_RTMP_PROVIDER_PORT = '1935'
# Additional RTMP hostnames equivalent to OME_PROVIDER_HOST -- shown to users
# as alternate publish URLs on /stream_info and accepted by the
# AdmissionWebhook (e.g. an internal/docker hostname alongside the public
# one). List of strings, can be empty. Other ingest protocols (e.g. WHIP,
# below) are trusted by the webhook independently and don't need to be
# listed here.
RTMP_ALT_HOSTS = []
# App name as configured in OME
OME_APP_NAME = 'app'
# Host of your webrtc publisher, if you aren't using a separate edge and
# origin this will probbably be the same as your provider above.
OME_PUBLISHER_HOST = 'localhost'
OME_PUBLISHER_PORT = '3334'
# Optional: LL-HLS endpoint for the /lite player, if it differs from the
# WebRTC publisher above. Leave commented out to reuse
# OME_PUBLISHER_HOST/OME_PUBLISHER_PORT (OME serves LL-HLS on the same TLS
# port as WebRTC signaling by default).
# OME_LLHLS_HOST = 'localhost'
# OME_LLHLS_PORT = '3334'

# Base WHIP (WebRTC-HTTP Ingestion Protocol) ingest URL, used by the
# in-browser "Go Live!" screenshare page (/go_live) to publish directly from
# the browser instead of an external RTMP client. Must be https://. Its host
# is authorized through the same AdmissionWebhook as RTMP, independently of
# RTMP_ALT_HOSTS -- no need to also list it there. The app appends
# '/<userid>_<streamkey>' itself. Leave blank to hide the Go Live page's
# publish controls (e.g. 'https://park.raku.party:3334/rakuspace').
OME_WHIP_URL = ''

# Where flask will bind to using its built in debug server, only used
# when running the debug server, gunicorn etc will not use this.
SITE_HOST='localhost'
SITE_PORT='5000'

# Path to user db file including file name, defaults to same directory
# as the script.
DB_PATH = 'users.db'

# Enable reading the username from HTTP Basic Auth. The password is not
# checked at all -- this is not real authentication, just a zero-setup way
# to switch users during local development without a real auth layer
# (Authelia etc) in front. Only ever enable this on a machine only you can
# reach.
BASICAUTH_ENABLED = 'False'

# --- Go-live notifications ---
# Basic SSRF validation of user-supplied notify URLs (scheme + block private/loopback hosts).
NOTIFY_VALIDATE_URLS = 'True'
# Restrict notify URLs to an admin-defined host whitelist.
NOTIFY_URL_WHITELIST_ENABLED = 'False'
NOTIFY_URL_WHITELIST = []            # list of allowed hostnames, e.g. ['discord.com']
# Debounce: how long a stream state must be stable before we notify, and how often we scan.
NOTIFY_SETTLE_SECONDS = 15
# Longer debounce specifically for going offline, so a brief drop (OME restart, network
# blip) that reconnects within this window is treated as a continuation of the same
# stream, not a new offline+live notification pair.
NOTIFY_OFFLINE_GRACE_SECONDS = 120
NOTIFY_TICK_SECONDS = 5
# HTTP timeout for the outbound notification POST.
NOTIFY_TIMEOUT_SECONDS = 3
# Optional public base URL used to build the stream link in the payload (e.g. https://raku.party).
# Leave empty to omit the link.
SITE_PUBLIC_URL = ''
